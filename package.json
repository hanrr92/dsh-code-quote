{
  "name": "dsh-code-quote",
  "version": "0.2.0",
  "description": "粘贴「路径:行号 + 代码」到 DSH 输入框时自动折叠为紧凑引用，发送时把代码快照以独立上下文消息内联给模型。",
  "type": "module",
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "code-quote",
    "composer"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanrr92/dsh-code-quote.git"
  },
  "homepage": "https://github.com/hanrr92/dsh-code-quote#readme",
  "bugs": {
    "url": "https://github.com/hanrr92/dsh-code-quote/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
